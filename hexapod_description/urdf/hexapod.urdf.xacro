<?xml version="1.0"?>
<!--
  Hexapod robot description.

  Frame convention: x forward, y left, z up (REP-103).
  Legs are named <position><side>: fl ml rl / fr mr rr. These names match
  hexapod_gazebo/config/ros2_controllers.yaml AND the servo table in
  hexapod_esp/src/hexapod_esp.cpp - the controller spawner and the firmware both
  match joints by exact name, so keep all three in sync.

  All dimensions come from urdf/common.xacro, which is the single place to edit
  when you re-measure the hardware.
-->
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Path to ros2_controllers.yaml, injected by the launch file so the
       gz_ros2_control plugin can find it at spawn time. -->
  <xacro:arg name="controllers_file" default=""/>
  <!-- Flip to true once real meshes land in hexapod_description/meshes. -->
  <xacro:arg name="use_meshes" default="false"/>
  <!-- Set false for a plain URDF with no Gazebo / ros2_control tags. -->
  <xacro:arg name="simulation" default="true"/>

  <xacro:include filename="$(find hexapod_description)/urdf/common.xacro"/>
  <xacro:include filename="$(find hexapod_description)/urdf/leg.xacro"/>
  <xacro:include filename="$(find hexapod_description)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find hexapod_description)/urdf/hexapod.ros2_control.xacro"/>

  <!-- ==================== body ==================== -->

  <!-- Massless root. Gazebo wants an inertia-free link at the root of a
       floating-base tree, otherwise the base picks up a phantom mass. -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${body_height}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <xacro:if value="$(arg use_meshes)">
          <mesh filename="package://hexapod_description/meshes/body.stl" scale="0.001 0.001 0.001"/>
        </xacro:if>
        <xacro:unless value="$(arg use_meshes)">
          <box size="${body_length} ${body_width} ${body_thickness}"/>
        </xacro:unless>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_thickness}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${body_mass}"
                       x="${body_length}" y="${body_width}" z="${body_thickness}"/>
  </link>

  <!-- ==================== legs ====================

       TOP-DOWN VIEW (x = forward, y = left)

               fl  \   40deg   /  fr
                    \    |    /
        ml ==========[ BODY ]========== mr      mid legs at +/-90 deg
                    /    |    \
               rl  /   140deg  \  rr

       Front legs splay 40 deg off the forward centreline, rear legs mirror them
       at 180-40 deg, mid legs point straight out. Together these put the six
       feet on a roughly regular hexagon, which is what keeps the tripod gait
       statically stable.
  -->

  <xacro:leg prefix="fl" x="${ body_mount_x}" y="${ body_mount_y}" mount_yaw="${ radians(leg_splay_deg)}"/>
  <xacro:leg prefix="ml" x="${         0.0}" y="${ body_mount_y}" mount_yaw="${ radians(90)}"/>
  <xacro:leg prefix="rl" x="${-body_mount_x}" y="${ body_mount_y}" mount_yaw="${ radians(180 - leg_splay_deg)}"/>

  <xacro:leg prefix="fr" x="${ body_mount_x}" y="${-body_mount_y}" mount_yaw="${-radians(leg_splay_deg)}"/>
  <xacro:leg prefix="mr" x="${         0.0}" y="${-body_mount_y}" mount_yaw="${-radians(90)}"/>
  <xacro:leg prefix="rr" x="${-body_mount_x}" y="${-body_mount_y}" mount_yaw="${-radians(180 - leg_splay_deg)}"/>

  <!-- ==================== sensors ==================== -->

  <xacro:sensor_suite/>

  <!-- ==================== simulation plumbing ==================== -->

  <xacro:if value="$(arg simulation)">
    <xacro:hexapod_ros2_control controllers_file="$(arg controllers_file)"/>
    <xacro:gazebo_surfaces/>
  </xacro:if>

</robot>
